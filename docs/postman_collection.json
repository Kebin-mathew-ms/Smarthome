		{
			"name": "6. Production Health & Security Tests",
			"item": [
				{
					"name": "Get Platform General Health",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Health status is UP', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.status).to.eql('UP');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Get Database Health",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/health/database",
							"host": ["{{baseUrl}}"],
							"path": ["health", "database"]
						}
					}
				},
				{
					"name": "XSS Payload Attack Test (Sanitized)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{customer_token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"<script>alert('xss')</script>\",\n  \"notes\": \"<img src=x onerror=alert(1)>\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/addresses",
							"host": ["{{baseUrl}}"],
							"path": ["addresses"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('XSS Payload was sanitized safely', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "SQL Injection Attack Test (Prevented)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"' OR '1'='1\",\n  \"password\": \"' OR '1'='1\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/login",
							"host": ["{{baseUrl}}"],
							"path": ["login"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('SQL Injection safely blocked with 401', function () {",
									"    pm.response.to.have.status(401);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Unauthorized Access Test (Missing Token)",
					"request": {
